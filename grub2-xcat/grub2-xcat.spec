Summary: grub2 resources generated by grub2-mknetdir
Name: grub2-xcat
# This el10 rewrite reset the version scheme from the el7-era 2.02 down to 1.0, but
# xCAT-server still Requires: grub2-xcat >= 2.02-0.76.el7.1.snap201905160255. An Epoch
# bump makes 1:1.0 outrank 0:2.02 so the (unchanged) xCAT-server dependency resolves.
Epoch: 1
Version: 1.0
#Release: snap%(date +"%Y%m%d%H%M")
Release: 5
License: GPLv3+
Group: Applications/System
Vendor: IBM Corp.
Packager: IBM Corp.
#Distribution: %{?_distribution:%{_distribution}}%{!?_distribution:%{_vendor}}
Prefix: /tftpboot/boot/grub2
BuildRoot: /var/tmp/%{name}-root
BuildArch: noarch
# grub2-mknetdir output from a RHEL7 POWER node; every file in it is dated 2014-05-21. Only the
# targets that cannot build the powerpc-ieee1275 image still unpack it: openEuler and openSUSE.
Source1: grub2-res.tar.gz
# EL10 riscv64 grub2 UEFI image, taken unmodified from the Rocky Linux 10
# BaseOS riscv64 tree (EFI/BOOT/grubriscv64.efi, built from
# grub2-2.12-46.el10_2.rocky.0.1.src.rpm, GPL-3.0-or-later); see readme.
Source2: grubriscv64.efi
# aarch64 nodes boot through UEFI and grub2 like riscv64, but the distro grubaa64.efi
# carries the distro prefix (/EFI/<vendor>) and never finds the boot/grub2/grub.cfg-*
# that nodeset writes. The aarch64 image is therefore generated here with grub2-mkimage
# and the /boot/grub2 prefix grub2.ppc uses. grub2-efi-aa64-modules is noarch, so the
# image builds on every EL build host. The openEuler x86_64 repositories carry no
# grub2-efi-aa64-modules and openEuler has no aarch64 target, so it ships without the image.
# openSUSE packages grub2 under other names, so its package ships without the image too.
# The powerpc-ieee1275 loader is generated here for the same reason, and because nothing ever
# generated it: grub2-res.tar.gz carries a 2014 core.elf that registers net_bootp and not
# net_bootp6, so a ppc64le node that leases its address over DHCPv6 reaches a loader with no
# DHCPv6 client. grub2-ppc64le-modules is noarch and carries net_bootp6 on EL8, EL9 and EL10.
# openEuler packages the modules under the same name but needs grub2-tools, which only the EL
# branch below requires; openSUSE names them grub2-powerpc-ieee1275 and Leap 42.3 ships none.
%if ! 0%{?openEuler} && ! 0%{?suse_version}
BuildRequires: grub2-tools
BuildRequires: grub2-efi-aa64-modules
BuildRequires: grub2-ppc64le-modules
%endif

Provides: grub2-xcat 
Requires:/bin/sh


%description
grub2-xcat provides the grub2 network images xCAT hands a node: an xCAT-prefixed Open Firmware
image for ppc64le nodes, an xCAT-prefixed UEFI image for aarch64 nodes, and the EL grub2 UEFI
image for riscv64 nodes.

%define _binaries_in_noarch_packages_terminate_build   0
%if 0%{?openEuler}
%global __strip /bin/true
%endif

%prep
#cp ./grub2-res.tar.gz /root/rpmbuild/SOURCES/
#%ifos linux
#tar zxf %{SOURCE1}
#%else
#rm -rf tftpboot
#cp %{SOURCE1} /opt/freeware/src/packages/BUILD
#gunzip -f grub2-res.tar.gz
#tar -xf grub2-res.tar
#%endif

%build
%if ! 0%{?openEuler} && ! 0%{?suse_version}
# The aarch64 network loader: net search finds the boot/grub2/grub.cfg-<HEXIP> that
# nodeset links. efi_uga is left out: it is x86 only, and grub2-mkimage aborts on it
# for arm64-efi.
grub2-mkimage -O arm64-efi -p /boot/grub2 -o %{_builddir}/grubaa64.efi \
  tftp efinet net http normal linux configfile search search_fs_file search_fs_uuid \
  search_label echo test cat ls boot reboot halt help fat ext2 xfs part_gpt part_msdos \
  gzio all_video video efi_gop font gettext terminal terminfo loadenv read sleep

# The ppc64le network loader, which SLOF loads as boot/grub2/grub2.ppc. The image is
# self-contained: it fetches no .mod at run time, because a 2.12 core.elf cannot load a module
# from another grub build, and that mismatch produces the rescue prompt this replaces. ofnet is
# the Open Firmware network driver and elf is what the ppc64le kernel needs.
grub2-mkimage -O powerpc-ieee1275 -p /boot/grub2 -o %{_builddir}/core.elf \
  net tftp http ofnet normal linux elf configfile search search_fs_file search_fs_uuid \
  search_label echo test cat ls boot reboot halt help ext2 xfs part_gpt part_msdos \
  gzio terminal loadenv read sleep
%endif

%pre


%install
mkdir -p $RPM_BUILD_ROOT/%{prefix}/
cd $RPM_BUILD_ROOT/%{prefix}/

%ifos linux
%if 0%{?openEuler} || 0%{?suse_version}
tar zxf %{SOURCE1}
%else
# The generated image carries every module it needs, so powerpc-ieee1275/ holds the image only.
# Unpacking grub2-res.tar.gz here would add 187 files from 2014 that this core.elf cannot load.
mkdir -p $RPM_BUILD_ROOT/%{prefix}/powerpc-ieee1275
install -m 0644 %{_builddir}/core.elf $RPM_BUILD_ROOT/%{prefix}/powerpc-ieee1275/core.elf
%endif
%else
cp %{SOURCE1} $RPM_BUILD_ROOT/%{prefix}/
gunzip -f grub2-res.tar.gz
tar -xf grub2-res.tar
%endif
mkdir -p $RPM_BUILD_ROOT/%{prefix}/riscv64-efi
install -m 0644 %{SOURCE2} $RPM_BUILD_ROOT/%{prefix}/riscv64-efi/grubriscv64.efi
%if ! 0%{?openEuler} && ! 0%{?suse_version}
mkdir -p $RPM_BUILD_ROOT/%{prefix}/aarch64-efi
install -m 0644 %{_builddir}/grubaa64.efi $RPM_BUILD_ROOT/%{prefix}/aarch64-efi/grubaa64.efi
%endif



%post
rm -f %{prefix}/grub2.ppc
cp  %{prefix}/powerpc-ieee1275/core.elf %{prefix}/grub2.ppc
# riscv64 firmware loads boot/grub2/grub2.riscv64 (DHCP client architecture 27)
rm -f %{prefix}/grub2.riscv64
cp  %{prefix}/riscv64-efi/grubriscv64.efi %{prefix}/grub2.riscv64
# aarch64 firmware loads boot/grub2/grub2.aarch64 (DHCP client architecture 11)
rm -f %{prefix}/grub2.aarch64
if [ -f %{prefix}/aarch64-efi/grubaa64.efi ]; then
   cp  %{prefix}/aarch64-efi/grubaa64.efi %{prefix}/grub2.aarch64
fi
exit 0

%clean


%files
#%{prefix}
# one for sles, one for rhel. yes, it's ugly...
%{prefix}/powerpc-ieee1275/
%{prefix}/riscv64-efi/
%if ! 0%{?openEuler} && ! 0%{?suse_version}
%{prefix}/aarch64-efi/
%endif
%defattr(-,root,root)

%postun

if [ "$1" = "0"  ]; then
   rm %{prefix}/grub2.ppc
   rm -f %{prefix}/grub2.riscv64
   rm -f %{prefix}/grub2.aarch64
fi
true
